# Salin menjadi .env, JANGAN di-commit
LLM_PROVIDER=gemini
LLM_API_KEY=isi_api_key_di_sini
LLM_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=20
ALLOWED_ORIGINS=http://localhost:5173
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
LLM_RETRIES=2
LLM_TOTAL_DEADLINE_SECONDS=45

RAG_AMBANG=0.6

# Diisi saat deploy publik; backend mengirimnya di header X-API-Key. Kosong = tanpa pengaman (lokal).
SERVICE_API_KEY=
